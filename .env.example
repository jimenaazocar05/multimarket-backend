# === Base de datos ===
# Postgres local levantado por docker-compose (servicio "db", puerto expuesto 5434).
# La API corre fuera de Docker (venv local), por eso el host es "localhost" y no "db".
DATABASE_URL=postgresql://multimarket:multimarket@localhost:5434/multimarket

# === Frontend ===
# Dominio del frontend para CORS
FRONTEND_ORIGIN=http://localhost:8080
